{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hisaho-hp-test",
  "account_id": "83a0f92e6468ea2246ad522d87aaea0a",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/admin", "/admin/*", "/api/*", "/news", "/news/*", "/news.html", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hisaho-hp-cms",
      "database_id": "f95fbec0-e8f4-4720-976c-ae24977c43af"
    }
  ],
  "env": {
    "production": {
      "name": "hisaho-hp",
      "account_id": "d2874089eebcda705bf220d39f117aec",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hisaho-hp-cms",
          "database_id": "5863e00b-09c5-4cc9-b344-a07b19ffb821"
        }
      ]
    }
  }
}
